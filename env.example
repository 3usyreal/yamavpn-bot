# Скопируйте в .env на сервере: cp env.example .env
BOT_TOKEN=
# Ваш Telegram ID (несколько через запятую)
ADMIN_IDS=
# Токен Crypto Pay (@CryptoBot -> Crypto Pay -> Create App). Пусто = оплата криптой выключена
CRYPTO_PAY_TOKEN=
# ЮKassa: данные магазина из личного кабинета (Интеграция -> Ключи API). Пусто = выключено
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
MARZBAN_URL=https://yamavpn.duckdns.org:8000
MARZBAN_USER=
MARZBAN_PASS=
# Тег inbound в Marzban. Пусто = все inbound
INBOUND_TAG=
# flow для VLESS Reality, выставляется пользователям автоматически
VLESS_FLOW=xtls-rprx-vision
SUPPORT_URL=
# Канал для обязательной подписки (бот должен быть админом канала). Пусто = проверка выключена
CHANNEL_ID=
CHANNEL_URL=
CHAT_URL=
REF_BONUS_DAYS=7
# Пробный период для новых пользователей, дней
TRIAL_DAYS=3
